# =========================
# EcoAudio Mapper
# macOS + Python + PostgreSQL/PostGIS + Alembic + VS Code + JetBrains
# Public GitHub repository safe .gitignore
# =========================

# --- OS / Finder ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# --- Editor / IDE ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.python-version

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Packaging / build ---
build/
dist/
site/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/

# --- Test / coverage / type check ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyre/
.ruff_cache/
.tox/
.nox/
hypothesis/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Logs / temp ---
*.log
logs/
tmp/
temp/
*.tmp

# --- Environment / secrets ---
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx

# --- Database local artifacts ---
*.sqlite
*.sqlite3
*.db

# --- PostgreSQL local dumps / backups ---
*.dump
*.backup
*.bak
pgdata/
postgres-data/

# --- GIS / generated cache ---
*.gpkg-shm
*.gpkg-wal
*.qgz~
*.aux.xml

# --- Alembic / migrations artifacts ---
# Keep migration source files, ignore compiled/python cache only
alembic/__pycache__/
alembic/versions/__pycache__/

# --- Node / frontend ---
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn-cache/
.next/
.nuxt/
dist-ssr/
coverage/

# --- Frontend env / build ---
*.tsbuildinfo

# --- Media / ML generated artifacts ---
artifacts/
exports/
derived/
spectrograms/
waveforms/
checkpoints/
model_cache/
.cache/
mlruns/

# --- Uploaded or collected field media (do not commit raw capture by default) ---
data/raw/
data/private/
data/tmp/
uploads/

# --- Generated reports / exports ---
reports/generated/
exports/generated/

# --- Docker / container local overrides ---
docker-compose.override.yml
*.local.yml

# --- Terraform / cloud local state ---
.terraform/
*.tfstate
*.tfstate.*
crash.log

# --- macOS app / Xcode related, only if used later ---
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# --- Misc ---
*.swp
*.swo
*~
